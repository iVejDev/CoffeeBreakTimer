<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CoffeeBreakTimer.App.Controls"
             xmlns:viewModels="clr-namespace:CoffeeBreakTimer.App.ViewModels"
             x:Class="CoffeeBreakTimer.App.Views.MainPage"
             x:Name="RootPage"
             x:DataType="viewModels:MainViewModel"
             NavigationPage.HasNavigationBar="False">
    <Grid x:Name="PageRoot">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop x:Name="BackgroundStart"
                              Color="{AppThemeBinding Light=#F8EFE3, Dark=#171210}"
                              Offset="0" />
                <GradientStop x:Name="BackgroundMid"
                              Color="{AppThemeBinding Light=#F3DEC8, Dark=#241712}"
                              Offset="0.62" />
                <GradientStop x:Name="BackgroundEnd"
                              Color="{AppThemeBinding Light=#E8C7A9, Dark=#120D0B}"
                              Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='Auto,*'}"
              ColumnSpacing="{OnIdiom Phone=0, Desktop=18}"
              Padding="{OnIdiom Phone='0', Desktop='18,18,18,18'}">
            <Border x:Name="Sidebar"
                    WidthRequest="{OnIdiom Phone=0, Desktop=150}"
                    IsVisible="{OnIdiom Phone=False, Desktop=True}"
                    Padding="12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                    BackgroundColor="{AppThemeBinding Light=#CFFFF7EC, Dark=#8F2D231F}"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#241006"
                            Offset="0,10"
                            Radius="22"
                            Opacity="0.16" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Workspace"
                           Margin="4,2,0,8"
                           Style="{StaticResource EyebrowLabel}" />
                    <Button x:Name="FocusNavButton"
                            Text="☕  Focus"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Focus"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="TasksNavButton"
                            Text="✓  Tasks"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Tasks"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="StatisticsNavButton"
                            Text="📊  Statistics"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Statistics"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="SettingsNavButton"
                            Text="⚙  Settings"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Settings"
                            Style="{StaticResource SidebarNavButton}" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Column="{OnIdiom Phone=0, Desktop=1}">
                <ScrollView x:Name="FocusWorkspace">
            <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="14"
                  MaximumWidthRequest="720"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CoffeeBreakerTimer"
                               FontSize="{OnIdiom Phone=26, Desktop=32}"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap" />
                        <Label Text="{Binding StatusText}"
                               FontSize="15"
                               Style="{StaticResource SecondaryLabel}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Padding="14,8"
                            VerticalOptions="Center"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E6CDB4, Dark=#4B372F}"
                            BackgroundColor="{AppThemeBinding Light=#FFF5E8, Dark=#2A1F1B}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="{Binding SessionTitle}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </Border>
                </Grid>

                <Border x:Name="TimerCard"
                        Grid.Row="1"
                        Padding="{OnIdiom Phone='22,20', Desktop='30,24'}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E8D1B8, Dark=#4A352C}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#3A1A0C"
                                Offset="0,16"
                                Radius="30"
                                Opacity="0.24" />
                    </Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="{AppThemeBinding Light=#FFF8EF, Dark=#2A201C}"
                                          Offset="0" />
                            <GradientStop Color="{AppThemeBinding Light=#F7E4CF, Dark=#1F1714}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                        <VerticalStackLayout Spacing="2"
                                             HorizontalOptions="Center">
                            <Label Text="{Binding TimeDisplay}"
                                   FontSize="{OnIdiom Phone=68, Desktop=86}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap" />
                            <Label x:Name="QuoteLabel"
                                   Margin="0,4,0,0"
                                   FontSize="15"
                                   FontAttributes="Italic"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Border Margin="0,8,0,0"
                                    Padding="{OnIdiom Phone='12,10', Desktop='14,10'}"
                                    WidthRequest="{OnIdiom Phone=250, Desktop=390}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#CFFFF7EC, Dark=#802D231F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="Current task"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextTransform="Uppercase"
                                               CharacterSpacing="0.6"
                                               Style="{StaticResource SecondaryLabel}" />
                                        <Label Text="{Binding SelectedFocusTaskTitle}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding SelectedFocusTaskProgressText}"
                                               FontSize="12"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               Style="{StaticResource SecondaryLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         WidthRequest="104"
                                                         VerticalOptions="Center">
                                        <Picker Title="{Binding FocusTaskPickerTitle}"
                                                ItemsSource="{Binding ActiveTasks}"
                                                SelectedItem="{Binding SelectedFocusTask, Mode=TwoWay}"
                                                IsEnabled="{Binding HasActiveTasks}"
                                                FontSize="12"
                                                HorizontalOptions="Fill"
                                                BackgroundColor="{AppThemeBinding Light=#BFFFF2E2, Dark=#663A2A24}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                                TitleColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                                            <Picker.ItemDisplayBinding>
                                                <Binding Path="ShortTitle"
                                                         x:DataType="viewModels:FocusTaskItemViewModel" />
                                            </Picker.ItemDisplayBinding>
                                        </Picker>
                                        <Button Text="Clear"
                                                Command="{Binding ClearFocusTaskCommand}"
                                                IsVisible="{Binding CanClearFocusTask}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4"
                                                FontSize="11"
                                                HeightRequest="30" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <ProgressBar Grid.Row="1"
                                     Progress="{Binding Progress}"
                                     HeightRequest="8"
                                     WidthRequest="{OnIdiom Phone=250, Desktop=390}"
                                     HorizontalOptions="Center"
                                     ProgressColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />

                        <controls:CoffeeMugView Grid.Row="2"
                                                CoffeeLevel="{Binding CoffeeLevel}"
                                                SessionType="{Binding SessionType}"
                                                RunState="{Binding RunState}"
                                                HorizontalOptions="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="14">
                    <Border Padding="14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                            BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#241006"
                                    Offset="0,10"
                                    Radius="20"
                                    Opacity="0.16" />
                        </Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10">
                            <Label Text="Focus duration"
                                   Style="{StaticResource EyebrowLabel}" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding WorkHoursText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="h"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding WorkRemainingMinutesText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="min"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                            BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#241006"
                                    Offset="0,10"
                                    Radius="20"
                                    Opacity="0.16" />
                        </Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10">
                            <Label Text="Break duration"
                                   Style="{StaticResource EyebrowLabel}" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding BreakHoursText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="h"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding BreakRemainingMinutesText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="min"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Padding="{OnIdiom Phone='16,14', Desktop='18,15'}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                        BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#241006"
                                Offset="0,8"
                                Radius="18"
                                Opacity="0.14" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="12"
                          VerticalOptions="Center">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="{OnIdiom Phone=14, Desktop=24}">
                            <Label Text="Ambience"
                                   Style="{StaticResource EyebrowLabel}"
                                   VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <Label Text="Rain"
                                       FontSize="13"
                                       Style="{StaticResource SecondaryLabel}"
                                       VerticalOptions="Center" />
                                <Switch IsToggled="{Binding IsRainAmbienceEnabled}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="2"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <Label Text="Chill"
                                       FontSize="13"
                                       Style="{StaticResource SecondaryLabel}"
                                       VerticalOptions="Center" />
                                <Switch IsToggled="{Binding IsChillAmbienceEnabled}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Label Text="Volume"
                                   FontSize="13"
                                   Style="{StaticResource SecondaryLabel}"
                                   VerticalOptions="Center" />
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    HeightRequest="38"
                                    MinimumWidthRequest="220"
                                    HorizontalOptions="Fill"
                                    Value="{Binding AmbienceVolume, Mode=TwoWay}"
                                    MinimumTrackColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                    MaximumTrackColor="{AppThemeBinding Light=#DDC4AA, Dark=#59433A}"
                                    ThumbColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                            <Label Grid.Column="2"
                                   Text="{Binding AmbienceVolumeDisplay}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   MinimumWidthRequest="42"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4"
                      ColumnDefinitions="1.2*,*,*"
                      ColumnSpacing="12">
                    <Button x:Name="StartButton"
                            Text="{Binding StartButtonText}"
                            Command="{Binding StartCommand}" />
                    <Button x:Name="PauseButton"
                            Grid.Column="1"
                            Text="Pause"
                            Command="{Binding PauseCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="ResetButton"
                            Grid.Column="2"
                            Text="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Grid>
                </ScrollView>

                <ScrollView x:Name="TasksWorkspace"
                            IsVisible="False"
                            Opacity="0">
                    <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="14"
                          MaximumWidthRequest="720"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tasks"
                                   FontSize="{OnIdiom Phone=26, Desktop=32}"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap" />
                            <Label Text="Keep today small, clear, and focused."
                                   FontSize="15"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>

                        <Border Grid.Row="1"
                                Padding="{OnIdiom Phone='18,16', Desktop='22,18'}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#241006"
                                        Offset="0,10"
                                        Radius="20"
                                        Opacity="0.16" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,Auto,Auto'}"
                                  ColumnSpacing="10"
                                  RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Desktop='Auto'}"
                                  RowSpacing="10">
                                <Entry Text="{Binding NewTaskTitle, Mode=TwoWay}"
                                       Placeholder="What are you focusing on?"
                                       ReturnType="Done"
                                       BackgroundColor="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}"
                                       TextColor="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}"
                                       PlaceholderColor="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
                                <Entry Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                       Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                       Text="{Binding NewTaskEstimatedSessionsText, Mode=TwoWay}"
                                       Placeholder="Sessions"
                                       Keyboard="Numeric"
                                       WidthRequest="96"
                                       HorizontalTextAlignment="Center"
                                       BackgroundColor="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}"
                                       TextColor="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}"
                                       PlaceholderColor="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
                                <Button Grid.Row="{OnIdiom Phone=2, Desktop=0}"
                                        Grid.Column="{OnIdiom Phone=0, Desktop=2}"
                                        Text="Add"
                                        HorizontalOptions="Fill"
                                        Command="{Binding AddTaskCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Padding="{OnIdiom Phone='10,8', Desktop='12,10'}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid>
                                <VerticalStackLayout IsVisible="{Binding HasNoTasks}"
                                                     Padding="22"
                                                     Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Label Text="No tasks yet"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Add one calm thing to work on."
                                           FontSize="14"
                                           Style="{StaticResource SecondaryLabel}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                                <CollectionView ItemsSource="{Binding Tasks}"
                                                IsVisible="{Binding HasTasks}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:FocusTaskItemViewModel">
                                            <Border Padding="12"
                                                    Margin="0,4"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                                    BackgroundColor="{AppThemeBinding Light=#CFFFF7EC, Dark=#9A2A211D}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <Grid IsVisible="{Binding IsNotEditing}"
                                                          ColumnDefinitions="{OnIdiom Phone='Auto,*', Desktop='Auto,*,Auto'}"
                                                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}"
                                                          ColumnSpacing="12"
                                                          RowSpacing="10">
                                                        <Button Text="{Binding CompletionMark}"
                                                                Command="{Binding ToggleCommand}"
                                                                WidthRequest="34"
                                                                HeightRequest="34"
                                                                Padding="0"
                                                                CornerRadius="17"
                                                                FontSize="16"
                                                                VerticalOptions="Center"
                                                                Style="{StaticResource SecondaryButton}" />
                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="2"
                                                                             VerticalOptions="Center">
                                                            <Label Text="{Binding Title}"
                                                                   FontSize="15"
                                                                   FontAttributes="Bold"
                                                                   MaxLines="1"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding FocusCardProgressText}"
                                                                   FontSize="13"
                                                                   Style="{StaticResource SecondaryLabel}" />
                                                        </VerticalStackLayout>
                                                        <HorizontalStackLayout Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                                                               Grid.Column="{OnIdiom Phone=1, Desktop=2}"
                                                                               Spacing="8"
                                                                               HorizontalOptions="{OnIdiom Phone=Start, Desktop=End}"
                                                                               VerticalOptions="Center">
                                                            <Button Text="Edit"
                                                                    Command="{Binding BeginEditCommand}"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="12,8"
                                                                    FontSize="12" />
                                                            <Button Text="Delete"
                                                                    Command="{Binding DeleteCommand}"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="12,8"
                                                                    FontSize="12" />
                                                        </HorizontalStackLayout>
                                                    </Grid>

                                                    <Grid IsVisible="{Binding IsEditing}"
                                                          ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,Auto'}"
                                                          RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Desktop='Auto,Auto'}"
                                                          ColumnSpacing="10"
                                                          RowSpacing="10">
                                                        <Entry Text="{Binding EditTitle, Mode=TwoWay}"
                                                               Placeholder="Task title"
                                                               BackgroundColor="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}"
                                                               TextColor="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}"
                                                               PlaceholderColor="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
                                                        <Entry Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                                               Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                                               Text="{Binding EditEstimatedSessionsText, Mode=TwoWay}"
                                                               Placeholder="Sessions"
                                                               Keyboard="Numeric"
                                                               WidthRequest="96"
                                                               HorizontalTextAlignment="Center"
                                                               BackgroundColor="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}"
                                                               TextColor="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}"
                                                               PlaceholderColor="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
                                                        <HorizontalStackLayout Grid.Row="{OnIdiom Phone=2, Desktop=1}"
                                                                               Grid.ColumnSpan="2"
                                                                               Spacing="8"
                                                                               HorizontalOptions="End">
                                                            <Button Text="Cancel"
                                                                    Command="{Binding CancelEditCommand}"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="12,8"
                                                                    FontSize="12" />
                                                            <Button Text="Save"
                                                                    Command="{Binding SaveEditCommand}"
                                                                    Padding="12,8"
                                                                    FontSize="12" />
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <ScrollView x:Name="StatisticsWorkspace"
                            IsVisible="False"
                            Opacity="0">
                    <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="14"
                          MaximumWidthRequest="720"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Statistics"
                                   FontSize="{OnIdiom Phone=26, Desktop=32}"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap" />
                            <Label Text="A quiet snapshot of your focus rhythm."
                               FontSize="15"
                               Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>

                        <Border Grid.Row="1"
                                Padding="20"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="12">
                                <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,Auto'}"
                                      RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}"
                                      ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Today"
                                               Style="{StaticResource EyebrowLabel}" />
                                        <Label Text="{Binding StatisticsTodaySummaryText}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding StatisticsTaskSummaryText}"
                                               FontSize="13"
                                               Style="{StaticResource SecondaryLabel}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                            Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                            Padding="14,10"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E6CDB4, Dark=#4B372F}"
                                            BackgroundColor="{AppThemeBinding Light=#BFFFF2E2, Dark=#663A2A24}"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="0"
                                                             HorizontalOptions="Center">
                                            <Label Text="{Binding StatisticsCurrentStreakDisplay}"
                                                   FontSize="24"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding StatisticsCurrentStreakLabel}"
                                                   FontSize="11"
                                                   Style="{StaticResource SecondaryLabel}"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Progress="{Binding StatisticsTaskCompletionProgress}"
                                             HeightRequest="7"
                                             ProgressColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />

                                <Label Grid.Row="2"
                                       Text="Task completion"
                                       FontSize="12"
                                       Style="{StaticResource SecondaryLabel}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,*'}"
                              RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto,Auto', Desktop='Auto,Auto'}"
                              ColumnSpacing="14"
                              RowSpacing="14">
                            <Border Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Focus time today"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsFocusTimeTodayDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                    Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Sessions today"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsTodaySessionsDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="{OnIdiom Phone=2, Desktop=1}"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Active tasks"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsActiveTasksDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="{OnIdiom Phone=3, Desktop=1}"
                                    Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="All sessions"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsCompletedSessionsDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3"
                                Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="10">
                                <Label Text="Recent focus sessions"
                                       Style="{StaticResource EyebrowLabel}" />

                                <VerticalStackLayout Grid.Row="1"
                                                     IsVisible="{Binding HasNoRecentFocusSessions}"
                                                     MinimumHeightRequest="48"
                                                     Spacing="4">
                                    <Label Text="No focus history yet"
                                           FontSize="15"
                                           FontAttributes="Bold" />
                                    <Label Text="Completed focus sessions will appear here."
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}" />
                                </VerticalStackLayout>

                                <CollectionView Grid.Row="1"
                                                ItemsSource="{Binding RecentFocusSessions}"
                                                IsVisible="{Binding HasRecentFocusSessions}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:FocusSessionHistoryItemViewModel">
                                            <Grid Padding="0,8"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="12">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding TaskTitleDisplay}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding CompletedAtDisplay}"
                                                           FontSize="12"
                                                           Style="{StaticResource SecondaryLabel}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="{Binding DurationDisplay}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       Style="{StaticResource SecondaryLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <ScrollView x:Name="SettingsWorkspace"
                            IsVisible="False"
                            Opacity="0">
                    <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="14"
                          MaximumWidthRequest="720"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Settings"
                                   FontSize="{OnIdiom Phone=26, Desktop=32}"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap" />
                            <Label Text="Small defaults for a calmer workspace."
                                   FontSize="15"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>

                        <Border Grid.Row="1"
                                Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="12">
                                <Label Text="Timer defaults"
                                       Style="{StaticResource EyebrowLabel}" />

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,*,*"
                                      ColumnSpacing="8">
                                    <Button Text="Classic"
                                            Command="{Binding ApplyClassicPresetCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,9"
                                            FontSize="12" />
                                    <Button Grid.Column="1"
                                            Text="Deep work"
                                            Command="{Binding ApplyDeepWorkPresetCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,9"
                                            FontSize="12" />
                                    <Button Grid.Column="2"
                                            Text="Long flow"
                                            Command="{Binding ApplyLongFlowPresetCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,9"
                                            FontSize="12" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,*'}"
                                      RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}"
                                      ColumnSpacing="14"
                                      RowSpacing="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Focus duration"
                                               FontSize="13"
                                               Style="{StaticResource SecondaryLabel}" />
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="4">
                                                <Entry Text="{Binding WorkHoursText, Mode=TwoWay}"
                                                       IsEnabled="{Binding IsDurationEditingEnabled}"
                                                       Style="{StaticResource DurationEntry}" />
                                                <Label Grid.Column="1"
                                                       Text="h"
                                                       FontSize="13"
                                                       Style="{StaticResource SecondaryLabel}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Grid Grid.Column="1"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="4">
                                                <Entry Text="{Binding WorkRemainingMinutesText, Mode=TwoWay}"
                                                       IsEnabled="{Binding IsDurationEditingEnabled}"
                                                       Style="{StaticResource DurationEntry}" />
                                                <Label Grid.Column="1"
                                                       Text="min"
                                                       FontSize="13"
                                                       Style="{StaticResource SecondaryLabel}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                                         Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                                         Spacing="8">
                                        <Label Text="Break duration"
                                               FontSize="13"
                                               Style="{StaticResource SecondaryLabel}" />
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="4">
                                                <Entry Text="{Binding BreakHoursText, Mode=TwoWay}"
                                                       IsEnabled="{Binding IsDurationEditingEnabled}"
                                                       Style="{StaticResource DurationEntry}" />
                                                <Label Grid.Column="1"
                                                       Text="h"
                                                       FontSize="13"
                                                       Style="{StaticResource SecondaryLabel}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Grid Grid.Column="1"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="4">
                                                <Entry Text="{Binding BreakRemainingMinutesText, Mode=TwoWay}"
                                                       IsEnabled="{Binding IsDurationEditingEnabled}"
                                                       Style="{StaticResource DurationEntry}" />
                                                <Label Grid.Column="1"
                                                       Text="min"
                                                       FontSize="13"
                                                       Style="{StaticResource SecondaryLabel}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8">
                                <Label Text="Notification sounds"
                                       Style="{StaticResource EyebrowLabel}" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding NotificationSoundsEnabled}" />
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="Play a soft voice cue when focus or break ends."
                                       FontSize="13"
                                       Style="{StaticResource SecondaryLabel}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="12">
                                <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,Auto,Auto'}"
                                      RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Desktop='Auto'}"
                                      ColumnSpacing="24"
                                      RowSpacing="8">
                                    <Label Text="Ambience defaults"
                                           Style="{StaticResource EyebrowLabel}"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                                           Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                                           Spacing="8"
                                                           VerticalOptions="Center">
                                        <Label Text="Rain"
                                               FontSize="13"
                                               Style="{StaticResource SecondaryLabel}"
                                               VerticalOptions="Center" />
                                        <Switch IsToggled="{Binding IsRainAmbienceEnabled}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Row="{OnIdiom Phone=2, Desktop=0}"
                                                           Grid.Column="{OnIdiom Phone=0, Desktop=2}"
                                                           Spacing="8"
                                                           VerticalOptions="Center">
                                        <Label Text="Chill"
                                               FontSize="13"
                                               Style="{StaticResource SecondaryLabel}"
                                               VerticalOptions="Center" />
                                        <Switch IsToggled="{Binding IsChillAmbienceEnabled}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">
                                    <Label Text="Volume"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                    <Slider Grid.Column="1"
                                            Minimum="0"
                                            Maximum="1"
                                            HeightRequest="38"
                                            Value="{Binding AmbienceVolume, Mode=TwoWay}"
                                            MinimumTrackColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                            MaximumTrackColor="{AppThemeBinding Light=#DDC4AA, Dark=#59433A}"
                                            ThumbColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                    <Label Grid.Column="2"
                                           Text="{Binding AmbienceVolumeDisplay}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           MinimumWidthRequest="42"
                                           HorizontalTextAlignment="End"
                                           VerticalOptions="Center"
                                           Style="{StaticResource SecondaryLabel}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4"
                                Padding="18"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Data management"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="Light cleanup tools for local tasks, statistics, and preferences."
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}" />
                                </VerticalStackLayout>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="{OnIdiom Phone='*', Desktop='*,*,*'}"
                                      RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Desktop='Auto'}"
                                      ColumnSpacing="10"
                                      RowSpacing="10">
                                    <Button Text="Clear done tasks"
                                            Command="{Binding ClearCompletedTasksCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,10"
                                            FontSize="12" />
                                    <Button Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                            Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                            Text="Reset statistics"
                                            Command="{Binding ResetStatisticsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,10"
                                            FontSize="12" />
                                    <Button Grid.Row="{OnIdiom Phone=2, Desktop=0}"
                                            Grid.Column="{OnIdiom Phone=0, Desktop=2}"
                                            Text="Reset preferences"
                                            Command="{Binding ResetAppPreferencesCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,10"
                                            FontSize="12" />
                                </Grid>

                                <Label Grid.Row="2"
                                       Text="All data is stored locally on this device."
                                       FontSize="12"
                                       Style="{StaticResource SecondaryLabel}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <Border x:Name="PlaceholderWorkspace"
                        IsVisible="False"
                        Opacity="0"
                        Padding="32"
                        MaximumWidthRequest="720"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                        BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <Label x:Name="PlaceholderTitle"
                               Text="Tasks"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="PlaceholderSubtitle"
                               Text="Coming next"
                               FontSize="14"
                               Style="{StaticResource SecondaryLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
