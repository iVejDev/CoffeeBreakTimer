<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CoffeeBreakTimer.App.Controls"
             xmlns:viewModels="clr-namespace:CoffeeBreakTimer.App.ViewModels"
             x:Class="CoffeeBreakTimer.App.Views.MainPage"
             x:Name="RootPage"
             x:DataType="viewModels:MainViewModel"
             NavigationPage.HasNavigationBar="False">
    <Grid x:Name="PageRoot">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop x:Name="BackgroundStart"
                              Color="{AppThemeBinding Light=#F8EFE3, Dark=#171210}"
                              Offset="0" />
                <GradientStop x:Name="BackgroundMid"
                              Color="{AppThemeBinding Light=#F3DEC8, Dark=#241712}"
                              Offset="0.62" />
                <GradientStop x:Name="BackgroundEnd"
                              Color="{AppThemeBinding Light=#E8C7A9, Dark=#120D0B}"
                              Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='Auto,*'}"
              ColumnSpacing="{OnIdiom Phone=0, Desktop=18}"
              Padding="{OnIdiom Phone='0', Desktop='18,18,18,18'}">
            <Border x:Name="Sidebar"
                    WidthRequest="{OnIdiom Phone=0, Desktop=150}"
                    IsVisible="{OnIdiom Phone=False, Desktop=True}"
                    Padding="12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                    BackgroundColor="{AppThemeBinding Light=#CFFFF7EC, Dark=#8F2D231F}"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#241006"
                            Offset="0,10"
                            Radius="22"
                            Opacity="0.16" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Workspace"
                           Margin="4,2,0,8"
                           Style="{StaticResource EyebrowLabel}" />
                    <Button x:Name="FocusNavButton"
                            Text="☕  Focus"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Focus"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="TasksNavButton"
                            Text="✓  Tasks"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Tasks"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="StatisticsNavButton"
                            Text="📊  Statistics"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Statistics"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="SettingsNavButton"
                            Text="⚙  Settings"
                            Command="{Binding SelectWorkspaceSectionCommand}"
                            CommandParameter="Settings"
                            Style="{StaticResource SidebarNavButton}" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Column="{OnIdiom Phone=0, Desktop=1}">
                <ScrollView x:Name="FocusWorkspace">
            <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="14"
                  MaximumWidthRequest="720"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CoffeeBreakerTimer"
                               FontSize="{OnIdiom Phone=26, Desktop=32}"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap" />
                        <Label Text="{Binding StatusText}"
                               FontSize="15"
                               Style="{StaticResource SecondaryLabel}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Padding="14,8"
                            VerticalOptions="Center"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E6CDB4, Dark=#4B372F}"
                            BackgroundColor="{AppThemeBinding Light=#FFF5E8, Dark=#2A1F1B}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="{Binding SessionTitle}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </Border>
                </Grid>

                <Border x:Name="TimerCard"
                        Grid.Row="1"
                        Padding="{OnIdiom Phone='22,20', Desktop='30,24'}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E8D1B8, Dark=#4A352C}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#3A1A0C"
                                Offset="0,16"
                                Radius="30"
                                Opacity="0.24" />
                    </Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="{AppThemeBinding Light=#FFF8EF, Dark=#2A201C}"
                                          Offset="0" />
                            <GradientStop Color="{AppThemeBinding Light=#F7E4CF, Dark=#1F1714}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                        <VerticalStackLayout Spacing="2"
                                             HorizontalOptions="Center">
                            <Label Text="{Binding TimeDisplay}"
                                   FontSize="{OnIdiom Phone=68, Desktop=86}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap" />
                            <Label x:Name="QuoteLabel"
                                   Margin="0,4,0,0"
                                   FontSize="15"
                                   FontAttributes="Italic"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Border Margin="0,8,0,0"
                                    Padding="12,6"
                                    WidthRequest="{OnIdiom Phone=250, Desktop=360}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#CFFFF7EC, Dark=#802D231F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                    <Label Text="Focus"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            Title="Choose task"
                                            ItemsSource="{Binding ActiveTasks}"
                                            SelectedItem="{Binding SelectedFocusTask, Mode=TwoWay}"
                                            IsEnabled="{Binding HasActiveTasks}"
                                            FontSize="13"
                                            HorizontalOptions="Fill"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                            TitleColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                                        <Picker.ItemDisplayBinding>
                                            <Binding Path="ShortTitle"
                                                     x:DataType="viewModels:FocusTaskItemViewModel" />
                                        </Picker.ItemDisplayBinding>
                                    </Picker>
                                </Grid>
                            </Border>
                            <Label Text="{Binding SelectedFocusTaskText}"
                                   FontSize="12"
                                   WidthRequest="{OnIdiom Phone=250, Desktop=390}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>

                        <ProgressBar Grid.Row="1"
                                     Progress="{Binding Progress}"
                                     HeightRequest="8"
                                     WidthRequest="{OnIdiom Phone=250, Desktop=390}"
                                     HorizontalOptions="Center"
                                     ProgressColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />

                        <controls:CoffeeMugView Grid.Row="2"
                                                CoffeeLevel="{Binding CoffeeLevel}"
                                                SessionType="{Binding SessionType}"
                                                RunState="{Binding RunState}"
                                                HorizontalOptions="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="14">
                    <Border Padding="14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                            BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#241006"
                                    Offset="0,10"
                                    Radius="20"
                                    Opacity="0.16" />
                        </Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10">
                            <Label Text="Focus duration"
                                   Style="{StaticResource EyebrowLabel}" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding WorkHoursText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="h"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding WorkRemainingMinutesText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="min"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                            BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#241006"
                                    Offset="0,10"
                                    Radius="20"
                                    Opacity="0.16" />
                        </Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10">
                            <Label Text="Break duration"
                                   Style="{StaticResource EyebrowLabel}" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding BreakHoursText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="h"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding BreakRemainingMinutesText, Mode=TwoWay}"
                                           IsEnabled="{Binding IsDurationEditingEnabled}"
                                           Style="{StaticResource DurationEntry}" />
                                    <Label Grid.Column="1"
                                           Text="min"
                                           FontSize="13"
                                           Style="{StaticResource SecondaryLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Padding="{OnIdiom Phone='16,14', Desktop='18,15'}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                        BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#241006"
                                Offset="0,8"
                                Radius="18"
                                Opacity="0.14" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="12"
                          VerticalOptions="Center">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="{OnIdiom Phone=14, Desktop=24}">
                            <Label Text="Ambience"
                                   Style="{StaticResource EyebrowLabel}"
                                   VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <Label Text="Rain"
                                       FontSize="13"
                                       Style="{StaticResource SecondaryLabel}"
                                       VerticalOptions="Center" />
                                <Switch IsToggled="{Binding IsRainAmbienceEnabled}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="2"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <Label Text="Chill"
                                       FontSize="13"
                                       Style="{StaticResource SecondaryLabel}"
                                       VerticalOptions="Center" />
                                <Switch IsToggled="{Binding IsChillAmbienceEnabled}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Label Text="Volume"
                                   FontSize="13"
                                   Style="{StaticResource SecondaryLabel}"
                                   VerticalOptions="Center" />
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    HeightRequest="38"
                                    MinimumWidthRequest="220"
                                    HorizontalOptions="Fill"
                                    Value="{Binding AmbienceVolume, Mode=TwoWay}"
                                    MinimumTrackColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                    MaximumTrackColor="{AppThemeBinding Light=#DDC4AA, Dark=#59433A}"
                                    ThumbColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                            <Label Grid.Column="2"
                                   Text="{Binding AmbienceVolumeDisplay}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   MinimumWidthRequest="42"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4"
                      ColumnDefinitions="1.2*,*,*"
                      ColumnSpacing="12">
                    <Button x:Name="StartButton"
                            Text="{Binding StartButtonText}"
                            Command="{Binding StartCommand}" />
                    <Button x:Name="PauseButton"
                            Grid.Column="1"
                            Text="Pause"
                            Command="{Binding PauseCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="ResetButton"
                            Grid.Column="2"
                            Text="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Grid>
                </ScrollView>

                <ScrollView x:Name="TasksWorkspace"
                            IsVisible="False"
                            Opacity="0">
                    <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="14"
                          MaximumWidthRequest="720"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tasks"
                                   FontSize="{OnIdiom Phone=26, Desktop=32}"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap" />
                            <Label Text="Keep today small, clear, and focused."
                                   FontSize="15"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>

                        <Border Grid.Row="1"
                                Padding="{OnIdiom Phone='18,16', Desktop='22,18'}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#241006"
                                        Offset="0,10"
                                        Radius="20"
                                        Opacity="0.16" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}"
                                  RowSpacing="10">
                                <Entry Text="{Binding NewTaskTitle, Mode=TwoWay}"
                                       Placeholder="What are you focusing on?"
                                       ReturnType="Done"
                                       BackgroundColor="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}"
                                       TextColor="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}"
                                       PlaceholderColor="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
                                <Entry Grid.Column="1"
                                       Text="{Binding NewTaskEstimatedSessionsText, Mode=TwoWay}"
                                       Placeholder="Sessions"
                                       Keyboard="Numeric"
                                       WidthRequest="96"
                                       HorizontalTextAlignment="Center"
                                       BackgroundColor="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}"
                                       TextColor="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}"
                                       PlaceholderColor="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
                                <Button Grid.Column="2"
                                        Text="Add"
                                        Command="{Binding AddTaskCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Padding="{OnIdiom Phone='10,8', Desktop='12,10'}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid>
                                <VerticalStackLayout IsVisible="{Binding HasNoTasks}"
                                                     Padding="22"
                                                     Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Label Text="No tasks yet"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Add one calm thing to work on."
                                           FontSize="14"
                                           Style="{StaticResource SecondaryLabel}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                                <CollectionView ItemsSource="{Binding Tasks}"
                                                IsVisible="{Binding HasTasks}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:FocusTaskItemViewModel">
                                            <Border Padding="12"
                                                    Margin="0,4"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                                    BackgroundColor="{AppThemeBinding Light=#CFFFF7EC, Dark=#9A2A211D}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="12">
                                                    <Button Text="{Binding CompletionMark}"
                                                            Command="{Binding ToggleCommand}"
                                                            WidthRequest="34"
                                                            HeightRequest="34"
                                                            Padding="0"
                                                            CornerRadius="17"
                                                            FontSize="16"
                                                            VerticalOptions="Center"
                                                            Style="{StaticResource SecondaryButton}" />
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="2"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding Title}"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               MaxLines="1"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding ProgressText}"
                                                               FontSize="13"
                                                               Style="{StaticResource SecondaryLabel}" />
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="2"
                                                            Text="Delete"
                                                            Command="{Binding DeleteCommand}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="12,8"
                                                            FontSize="12"
                                                            VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <ScrollView x:Name="StatisticsWorkspace"
                            IsVisible="False"
                            Opacity="0">
                    <Grid Padding="{OnIdiom Phone='22,22,22,28', Desktop='40,26,40,34'}"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="14"
                          MaximumWidthRequest="720"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Statistics"
                                   FontSize="{OnIdiom Phone=26, Desktop=32}"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap" />
                            <Label Text="A quiet snapshot of your focus rhythm."
                                   FontSize="15"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="14"
                              RowSpacing="14">
                            <Border Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Focus time today"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsFocusTimeTodayDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Completed sessions"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsCompletedSessionsDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Completed tasks"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsCompletedTasksDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Current streak"
                                           Style="{StaticResource EyebrowLabel}" />
                                    <Label Text="{Binding StatisticsCurrentStreakDisplay}"
                                           FontSize="30"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollView>

                <Border x:Name="PlaceholderWorkspace"
                        IsVisible="False"
                        Opacity="0"
                        Padding="32"
                        MaximumWidthRequest="720"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
                        BackgroundColor="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <Label x:Name="PlaceholderTitle"
                               Text="Tasks"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="PlaceholderSubtitle"
                               Text="Coming next"
                               FontSize="14"
                               Style="{StaticResource SecondaryLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
