<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeBreakTimer.App.Controls.CoffeeMugView"
             WidthRequest="{OnIdiom Phone=320, Desktop=380}"
             HeightRequest="{OnIdiom Phone=330, Desktop=370}">
    <Grid x:Name="MugStage"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          WidthRequest="380"
          HeightRequest="360"
          InputTransparent="True">
        <Ellipse x:Name="GlowView"
                 WidthRequest="250"
                 HeightRequest="250"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5"
                                     Radius="0.58">
                    <GradientStop Color="#80D39A68"
                                  Offset="0" />
                    <GradientStop Color="#00D39A68"
                                  Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="SteamLayer"
              HeightRequest="100"
              WidthRequest="180"
              HorizontalOptions="Center"
              VerticalOptions="Start"
              Margin="0,0,0,0"
              Opacity="0.78">
            <Border x:Name="SteamOne"
                    WidthRequest="8"
                    HeightRequest="58"
                    HorizontalOptions="Start"
                    Margin="44,18,0,0"
                    Rotation="-12"
                    BackgroundColor="{StaticResource Steam}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
            </Border>
            <Border x:Name="SteamTwo"
                    WidthRequest="8"
                    HeightRequest="74"
                    HorizontalOptions="Center"
                    Margin="0,2,0,0"
                    Rotation="8"
                    BackgroundColor="{StaticResource Steam}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
            </Border>
            <Border x:Name="SteamThree"
                    WidthRequest="8"
                    HeightRequest="56"
                    HorizontalOptions="End"
                    Margin="0,22,48,0"
                    Rotation="16"
                    BackgroundColor="{StaticResource Steam}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
            </Border>
        </Grid>

        <Ellipse WidthRequest="230"
                 HeightRequest="38"
                 HorizontalOptions="Center"
                 VerticalOptions="End"
                 Margin="0,0,0,31"
                 Fill="#331B12"
                 Opacity="0.35" />

        <Border WidthRequest="214"
                HeightRequest="176"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,60"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="36" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#55200F06"
                        Offset="0,18"
                        Radius="28"
                        Opacity="0.42" />
            </Border.Shadow>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FFF5E4"
                                  Offset="0" />
                    <GradientStop Color="#E7B98C"
                                  Offset="0.62" />
                    <GradientStop Color="#C98758"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border WidthRequest="90"
                HeightRequest="112"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="210,0,0,91"
                BackgroundColor="Transparent"
                Stroke="#E8BE95"
                StrokeThickness="18">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="52" />
            </Border.StrokeShape>
        </Border>

        <Border x:Name="LiquidClip"
                WidthRequest="164"
                HeightRequest="126"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="-4,0,0,91"
                StrokeThickness="0"
                BackgroundColor="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Grid>
                <Border x:Name="LiquidView"
                        VerticalOptions="End"
                        HorizontalOptions="Fill"
                        HeightRequest="0"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                </Border>
                <Border x:Name="LiquidHighlight"
                        HeightRequest="12"
                        WidthRequest="96"
                        VerticalOptions="End"
                        HorizontalOptions="Center"
                        Margin="0,0,0,0"
                        BackgroundColor="#40FFF4E4"
                        Opacity="0.75"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                </Border>
            </Grid>
        </Border>

        <Image Source="coffee_mug_outline.svg"
               WidthRequest="380"
               HeightRequest="326"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Aspect="AspectFit"
               InputTransparent="True" />
    </Grid>
</ContentView>
