<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Default" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="EyebrowLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Scale" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#FFF8EF, Dark=#24140D}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#33000000"
                        Offset="0,8"
                        Radius="18"
                        Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Scale" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#F4E1CF, Dark=#3A2B25}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#4E3427, Dark=#F8EBDD}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000"
                        Offset="0,5"
                        Radius="12"
                        Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarNavButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <Style x:Key="DurationEntry" TargetType="Entry">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="MinimumWidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style x:Key="CozyEntry" TargetType="Entry">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#F9E9D7, Dark=#3A2A24}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#3E281D, Dark=#FFF3E5}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light=#8D6B58, Dark=#BDA89B}" />
    </Style>

    <Style x:Key="CozyPanelBase" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CozyWarmPanel" TargetType="Border" BasedOn="{StaticResource CozyPanelBase}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#DFFFF7EC, Dark=#A82D231F}" />
    </Style>

    <Style x:Key="CozySoftPanel" TargetType="Border" BasedOn="{StaticResource CozyPanelBase}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#DFFFF3E4, Dark=#B82E231E}" />
    </Style>

    <Style x:Key="CozyItemPanel" TargetType="Border" BasedOn="{StaticResource CozyPanelBase}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#CFFFF7EC, Dark=#9A2A211D}" />
    </Style>

    <Style x:Key="CozyWarmPanelWithShadow" TargetType="Border" BasedOn="{StaticResource CozyWarmPanel}">
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#241006"
                        Offset="0,10"
                        Radius="20"
                        Opacity="0.16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CozySoftPanelWithShadow" TargetType="Border" BasedOn="{StaticResource CozySoftPanel}">
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#241006"
                        Offset="0,10"
                        Radius="20"
                        Opacity="0.16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Stepper">
        <Setter Property="Minimum" Value="1" />
        <Setter Property="Maximum" Value="240" />
        <Setter Property="Increment" Value="1" />
    </Style>
</ResourceDictionary>
