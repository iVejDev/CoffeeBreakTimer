<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Default" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="EyebrowLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Scale" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#FFF8EF, Dark=#24140D}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#33000000"
                        Offset="0,8"
                        Radius="18"
                        Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Scale" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#F4E1CF, Dark=#3A2B25}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#4E3427, Dark=#F8EBDD}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000"
                        Offset="0,5"
                        Radius="12"
                        Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Stepper">
        <Setter Property="Minimum" Value="1" />
        <Setter Property="Maximum" Value="240" />
        <Setter Property="Increment" Value="1" />
    </Style>
</ResourceDictionary>
